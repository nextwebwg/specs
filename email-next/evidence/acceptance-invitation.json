  "cases": [
    {
      "id": "invitation.admission-replay",
      "requirement": "../mls-invitations.md#accepting-an-invitation",
      "description": "A signed MIME invitation with an encrypted embedded tree admits the intended device; exact payload/signature retries retain the result while a changed signature cannot reuse it.",
      "test": "test_mls_invitation.InvitationTests.test_embedded_carrier_admission_and_replay_signature_boundary"
    },
    {
      "id": "invitation.authenticated-bindings",
      "requirement": "../mls-invitations.md#accepting-an-invitation",
      "description": "Missing embedded tree or mismatched signed target, group, context or Welcome prevents consumption; a valid retry still succeeds.",
      "test": "test_mls_invitation.InvitationTests.test_missing_tree_and_signed_target_context_tampering_do_not_consume"
    },
    {
      "id": "invitation.welcome-signer",
      "requirement": "../mls-invitations.md#accepting-an-invitation",
      "description": "The validated MLS GroupInfo signer must match the separately signed invitation creator.",
      "test": "test_mls_invitation.InvitationTests.test_validated_groupinfo_signer_differs_from_signed_creator"
    },
    {
      "id": "invitation.direct-carrier",
      "requirement": "../mls-invitations.md#delivery-through-email",
      "description": "Unknown schema fields, noncanonical encoding, duplicate attachments and forwarded nested carriers are rejected.",
      "test": "test_mls_invitation.InvitationTests.test_strict_schema_and_direct_mime_scope"
    },
    {
      "id": "invitation.mime-ambiguity",
      "requirement": "../mls-invitations.md#delivery-through-email",
      "description": "Malformed or duplicate MIME singleton fields and parameters are rejected.",
      "test": "test_mls_invitation.InvitationMimeTests.test_header_defects_and_ambiguous_singletons"
    },
    {
      "id": "invitation.notice-decoding",
      "requirement": "../mls-invitations.md#delivery-through-email",
      "description": "The readable notice is strictly transfer-decoded as UTF-8; supported encodings yield the same candidate attachment without conferring authority.",
      "test": "test_mls_invitation.InvitationMimeTests.test_notice_transfer_decoding_is_strict_and_not_authority"
    },
    {
      "id": "invitation.durable-sending",
      "requirement": "../mls-invitations.md#sender-release-and-retry",
      "description": "Prepare and release the invitation through a durable sender, including identity changes, retries and interrupted handoff.",
      "unavailable": "This manifest exercises candidate generation and receiver admission, not a complete invitation outbox and transport release path."
    },
    {
      "id": "invitation.deployed-carriage",
      "requirement": "../mls-invitations.md#delivery-through-email",
      "description": "Carry and retrieve the candidate invitation through actual providers and inspect its ordinary-client notice.",
      "unavailable": "No deployed provider or ordinary-client adapter participates in these local checks."
    },
    {
      "id": "invitation.independent-implementation",
      "requirement": "../mls-invitations.md#acceptance-and-remaining-work",
      "description": "Independently implemented clients produce and accept the same supported invitation profile.",
      "unavailable": "The checks use one local implementation and one security library with configured unverified identities."
    }
  ]
