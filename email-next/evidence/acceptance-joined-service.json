  "cases": [
    {
      "id": "effect-retry-renewal",
      "requirement": "../service-answers.md",
      "description": "Signed SMTP question reaches the configured HTTPS service; an exact retry with renewed credentials retains one effect.",
      "test": "test_joined_service.JoinedService.test_signed_smtp_https_effect_exact_retry_and_renewal"
    },
    {
      "id": "registration-and-credential",
      "requirement": "../service-answers.md",
      "description": "Changed registration or absent credentials holds the control.",
      "test": "test_joined_service.JoinedService.test_registration_snapshot_and_missing_credentials_hold"
    },
    {
      "id": "uncertain-outcome",
      "requirement": "../service-answers.md",
      "description": "Lost response reconciles through authorized status; withdrawal preserves uncertainty.",
      "test": "test_joined_service.JoinedService.test_lost_response_status_reconciliation_and_withdrawal"
    },
    {
      "id": "revoked-device",
      "requirement": "../service-answers.md",
      "description": "A signed send-role revocation holds an existing control.",
      "test": "test_joined_service.JoinedService.test_current_device_send_revocation_holds_existing_control"
    },
    {
      "id": "source-and-destination",
      "requirement": "../service-answers.md",
      "description": "Unaccepted source or wrong registration cannot authorize a service request.",
      "test": "test_joined_service.JoinedService.test_wrong_registration_and_unaccepted_carrier"
    },
    {
      "id": "exact-profile",
      "requirement": "../service-answers.md",
      "description": "Older profiles and incomplete operation agreement cannot enable service questions.",
      "test": "test_joined_service.JoinedService.test_explicit_tuple_not_old_profile_or_partial_intersection"
    },
    {
      "id": "independent-service",
      "requirement": "../adoption.md",
      "description": "An independently implemented client and service complete the same question and effect.",
      "unavailable": "No independent implementation has run this manifest."
    },
    {
      "id": "deployed-carriage",
      "requirement": "../adoption.md",
      "description": "The protected question survives deployed provider submission and retrieval.",
      "unavailable": "No deployed provider adapter has run this manifest."
    }
  ]
}
