  "cases": [
    {
      "id": "ordinary-protected",
      "requirement": "../capability-discovery.md",
      "description": "Ordinary mail bootstraps protected two-way exchange without a preloaded peer.",
      "test": "test_client_onboarding.Onboarding.test_ordinary_smtp_without_seeded_peer_then_protected_exchange"
    },
    {
      "id": "retry-no-network",
      "requirement": "../capability-discovery.md",
      "description": "Ingestion is passive and exact retries retain their decision.",
      "test": "test_client_onboarding.Onboarding.test_no_seed_ordinary_mail_and_exact_retry_no_network"
    },
    {
      "id": "atomic-policy",
      "requirement": "../capability-discovery.md",
      "description": "Verification-required mode and failed selection do not leave partial pins.",
      "test": "test_client_onboarding.Onboarding.test_strict_and_crash_never_partially_pin"
    },
    {
      "id": "competing-first-contact",
      "requirement": "../capability-discovery.md",
      "description": "Visible competing claims remain ambiguous; unrelated identities cannot replace a pin.",
      "test": "test_client_onboarding.Onboarding.test_competing_first_contact_and_later_unlinked_identity"
    },
    {
      "id": "device-coverage",
      "requirement": "../capability-discovery.md",
      "description": "Missing device evidence is visible and all-device policy waits.",
      "test": "test_client_onboarding.Onboarding.test_missing_required_second_device_is_explicit"
    },
    {
      "id": "restart-stripping",
      "requirement": "../capability-discovery.md",
      "description": "Restart and stripped advertisements preserve accepted continuity.",
      "test": "test_client_onboarding.Onboarding.test_restart_and_stripped_evidence_do_not_reset_pin"
    },
    {
      "id": "invalid-source",
      "requirement": "../capability-discovery.md",
      "description": "Expired evidence and mismatched From do not select a principal.",
      "test": "test_client_onboarding.Onboarding.test_expired_or_mismatched_from_cannot_pin"
    },
    {
      "id": "identity-conflict",
      "requirement": "../capability-discovery.md",
      "description": "Authorized identity conflicts remain relevant despite an unusable advertisement.",
      "test": "test_client_onboarding.Onboarding.test_authorized_successor_conflict_survives_unusable_advertisement"
    },
    {
      "id": "mixed-batch-conflict",
      "requirement": "../capability-discovery.md",
      "description": "An old-head candidate cannot roll back an authorized fork, regardless of batch order or exact retry.",
      "test": "test_client_onboarding.Onboarding.test_old_head_candidate_cannot_roll_back_authorized_fork_in_either_order"
    },
    {
      "id": "deployed-carriage",
      "requirement": "../adoption.md",
      "description": "Ordinary advertisements and protected follow-up survive an actual provider path.",
      "unavailable": "No deployed provider account adapter has run this manifest."
    },
    {
      "id": "independent-peer",
      "requirement": "../adoption.md",
      "description": "A separately implemented client interoperates with this passive baseline.",
      "unavailable": "No independent client has run this manifest."
    }
  ]
}
