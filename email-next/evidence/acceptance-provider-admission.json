  "cases": [
    {
      "id": "provider.admission.protected-roundtrip",
      "requirement": "../provider-control.md#implementation-and-acceptance-boundary",
      "description": "A configured HTTPS response supplies a signature- and authority-checked KeyPackage; locally authorized admission permits exact encrypted application delivery and an encrypted reply over loopback SMTP/MIME.",
      "test": "test_provider_mls.ProviderMlsTests.test_https_package_admission_and_encrypted_mail_reply"
    },
    {
      "id": "provider.admission.invalid-welcome-retry",
      "requirement": "../security-profile.md#single-use-admission-packages",
      "description": "Invalid Welcome bytes leave the local package available; a valid invitation succeeds and its exact retry returns the admitted group.",
      "test": "test_provider_mls.ProviderMlsTests.test_invalid_welcome_does_not_consume_then_exact_retry"
    },
    {
      "id": "provider.admission.admission-bindings",
      "requirement": "../security-profile.md#admission-and-asynchronous-delivery",
      "description": "Unexpected roster, context or current identity head prevents admission without consuming the package; the correctly configured invitation remains usable.",
      "test": "test_provider_mls.ProviderMlsTests.test_wrong_expected_roster_or_context_cannot_consume"
    },
    {
      "id": "provider.admission.single-use-race",
      "requirement": "../security-profile.md#single-use-admission-packages",
      "description": "Two concurrent connections admitting distinct valid invitations for one package commit exactly one admission and one checkpoint.",
      "test": "test_provider_mls.ProviderMlsTests.test_two_valid_invitations_only_one_consumes"
    },
    {
      "id": "provider.admission.crash-atomicity",
      "requirement": "../security-profile.md#single-use-admission-packages",
      "description": "Process exit before commit leaves both package and checkpoint uncommitted; exit after commit preserves both and permits exact retry after restart.",
      "test": "test_provider_mls.ProviderMlsTests.test_process_exit_before_and_after_commit"
    },
    {
      "id": "provider.public-credentials",
      "requirement": "../provider-control.md#implementation-and-acceptance-boundary",
      "description": "Public clients discover the authoritative provider and acquire revocable credentials interoperably.",
      "unavailable": "The experiment preconfigures bearer grants and endpoints; it does not implement public credential issuance, revocation or service discovery."
    },
    {
      "id": "provider.independent-implementation",
      "requirement": "../provider-control.md#implementation-and-acceptance-boundary",
      "description": "Independent clients and providers exchange discovery evidence and interoperable authorized invitations.",
      "unavailable": "One local reference implementation is exercised. Invitation authorization and its Welcome/tree transport envelope are locally configured, not a public interoperable binding."
    },
    {
      "id": "provider.deployed-mail-carriage",
