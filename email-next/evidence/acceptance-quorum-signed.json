  "cases": [
    {
      "id": "signed-initial-support",
      "requirement": "../ordering-exchange.md#explicit-exchange-support",
      "description": "Initial7 admission retains independently signed witness exchange support without a configured support row.",
      "test": "test_quorum_signed_exchange.SignedExchangeTests.test_initial7_admits_signed_exchange_support_without_configuration"
    },
    {
      "id": "signed-exchange-and-carrier",
      "requirement": "../ordering-exchange.md#mail-wrapper",
      "description": "Actual signed exchange1 SMTP delivery and carrier2 installation require exact witness evidence and reject old or reordered forms.",
      "test": "test_quorum_signed_exchange.SignedExchangeTests.test_signed_exchange1_and_carrier2_keep_old_versions_strict"
    },
    {
      "id": "sender-handshake-continuity",
      "requirement": "../ordering-proofs.md#local-candidate-installation",
      "description": "Consecutive signed7 candidates continue the durable predecessor handshake ratchet across restart and application traffic, while installing the earlier certified candidate preserves current message ratchets.",
      "test": "test_quorum_signed_exchange.SignedExchangeTests.test_sender_handshake_continuity"
    },
    {
      "id": "durable-established-release",
      "requirement": "../ordering-exchange.md#durability-and-retention",
      "description": "Established7 Welcome uses its fixed durable sender path after predecessor control delivery; the older sender path cannot substitute.",
      "test": "test_quorum_signed_exchange.SignedExchangeTests.test_established7_fixed_durable_release"
    },
    {
      "id": "assertion-domain-and-freshness",
      "requirement": "../ordering-exchange.md#explicit-exchange-support",
      "description": "Assertion7 rejects old shapes and exchange versions, wrong signature purpose and expired support.",
      "test": "test_quorum_signed_exchange.SignedExchangeTests.test_assertion7_schema_purpose_and_expiry"
    },
    {
      "id": "established-protected-traffic",
      "requirement": "../ordering-proofs.md#local-candidate-installation",
      "description": "A certified established7 join admits the recipient and exchanges actual protected application traffic.",
      "test": "test_quorum_signed_exchange.SignedExchangeTests.test_established7_actual_protected_exchange"
    },
    {
      "id": "signed-atomic-recovery",
      "requirement": "../group-conversations.md",
      "description": "Signed carrier2 recovery validates exact supplements and current final support, rolls back on crash, preserves exact retry, holds intervening application effects and permits a final protected reply.",
      "test": "test_quorum_signed_recovery.SignedRecoveryTests.test_signed_recovery_revoked_intermediate_and_exact_supplements"
    },
    {
      "id": "independent-peers",
      "requirement": "../interoperability.md#external-standardization-and-adoption-decisions",
      "description": "Independent implementations exchange the selected signed quorum lifecycle and recovery formats.",
      "unavailable": "No independent peer implementation has run this manifest."
    },
    {
      "id": "deployed-carriage",
      "requirement": "../adoption.md",
      "description": "Signed discovery, ordering exchange and protected application messages survive deployed provider submission and retrieval.",
      "unavailable": "No deployed provider adapter has run this manifest."
    },
    {
      "id": "independent-security-review",
      "requirement": "../interoperability.md#external-standardization-and-adoption-decisions",
      "description": "An independent security review assesses quorum safety, identity freshness, recovery and implementation boundaries.",
      "unavailable": "Local tests are not an independent security review; no such review is recorded by this manifest."
    }
  ]
