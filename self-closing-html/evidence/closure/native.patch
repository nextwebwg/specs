diff --git a/Tests/LibWeb/Text/input/HTML/next-parsing-refinement.html b/Tests/LibWeb/Text/input/HTML/next-parsing-refinement.html
new file mode 100644
index 00000000..d253c3e5
--- /dev/null
+++ b/Tests/LibWeb/Text/input/HTML/next-parsing-refinement.html
@@ -0,0 +1,34 @@
+<!doctype html>
+<script src="../include.js"></script>
+<script>
+asyncTest(async done=>{
+ const server=httpTestServer();
+ const corpus=await (await fetch(server.getStaticURL('Text/input/HTML/next-parsing-corpus.json'))).json();
+ const signature=node=>{
+  if(node.nodeType===10)return ['doctype',node.name,node.publicId,node.systemId];
+  if(node.nodeType===3)return ['text',node.data];
+  if(node.nodeType===8)return ['comment',node.data];
+  return [node.localName??node.nodeName,node.namespaceURI??null,node.attributes?[...node.attributes].map(a=>[a.name,a.value]):[],[...node.childNodes].map(signature),node.content?signature(node.content):null];
+ };
+ const report={seed:corpus.seed,inputs:corpus.cases.length,compared:0,authoringCompared:0,referenceCompared:0,baselineDisagreements:0,baselineExamples:[],mismatches:0,examples:[]};
+ for(let index=0;index<corpus.cases.length;index++){
+  const item=corpus.cases[index];
+  let expected=item.expected;
+  if(item.expanded){
+   const nativeExpected=signature(new DOMParser().parseFromString(item.expanded,'text/html'));
+   if(JSON.stringify(nativeExpected)!==JSON.stringify(item.baseline)){report.baselineDisagreements++;if(report.baselineExamples.length<3)report.baselineExamples.push({index,source:item.expanded,native:nativeExpected,reference:item.baseline});}
+   expected=nativeExpected;report.authoringCompared++;
+  }else report.referenceCompared++;
+  const url=await server.createEcho('GET',`/next-corpus-${index}`,{status:200,headers:{'Content-Type':'text/html; charset=utf-8'},body:item.source});
+  const frame=document.createElement('iframe');const loaded=new Promise(resolve=>frame.onload=resolve);frame.src=url;document.body.append(frame);await loaded;
+  const actual=signature(frame.contentDocument);report.compared++;
+  if(JSON.stringify(actual)!==JSON.stringify(expected)){
+   report.mismatches++;if(report.examples.length<5)report.examples.push({index,source:item.source,expected,actual});
+  }
+  frame.remove();
+ }
+ println(JSON.stringify(report));
+ println(`native static refinement: ${report.compared===corpus.cases.length&&report.mismatches===0?'PASS':'FAIL'}`);
+ done();
+});
+</script>
