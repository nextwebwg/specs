+<!doctype html>
+<script src="../include.js"></script>
+<script>
+asyncTest(async done=>{
+ const server=httpTestServer();
+ const utf8=s=>[...new TextEncoder().encode(s)];
+ const utf16=(s,little)=>{const bytes=little?[255,254]:[254,255];for(let i=0;i<s.length;i++){const n=s.charCodeAt(i);bytes.push(...(little?[n&255,n>>8]:[n>>8,n&255]));}return bytes;};
+ const source=(meta='')=>'<!doctype html PUBLIC "self-closing"><head>'+meta+'</head><body><small id="empty"/><span id="tail">café</span>';
+ const cases=[
+  ['UTF-8 header',utf8(source()),'text/html; charset=utf-8','UTF-8'],
+  ['UTF-8 BOM',[239,187,191,...utf8(source())],'text/html','UTF-8'],
+  ['UTF-16LE BOM',utf16(source(),true),'text/html','UTF-16LE'],
+  ['UTF-16BE BOM',utf16(source(),false),'text/html','UTF-16BE'],
+  ['windows-1252 header',[...source()].map(c=>c.charCodeAt(0)),'text/html; charset=windows-1252','windows-1252'],
+  ['windows-1252 meta',[...source('<meta charset="windows-1252">')].map(c=>c.charCodeAt(0)),'text/html','windows-1252'],
+ ];
+ let index=0;
+ for(const [name,bytes,type,encoding] of cases){
+  const url=await server.createEcho('GET','/closure-encoding-'+index++,{status:200,headers:{'Content-Type':type},body_encoding:'base64',body:btoa(String.fromCharCode(...bytes))});
+  const frame=document.createElement('iframe');const loaded=new Promise(resolve=>frame.onload=resolve);frame.src=url;document.body.append(frame);await loaded;
+  const d=frame.contentDocument;const pass=d.characterSet===encoding&&d.getElementById('empty')?.childNodes.length===0&&d.getElementById('tail')?.parentNode===d.body&&d.getElementById('tail')?.textContent==='café';
+  println('native encoding '+name+': '+(pass?'PASS':'FAIL charset='+d.characterSet+' DOM='+d.body.innerHTML));frame.remove();
+ }
+ done();
+});
+</script>
