+ await fetch(new URL(`/unblock/${asyncToken}`,asyncScript));await asyncLoad;
+ println(`native async script does not block source: ${asyncNonblocking&&asyncFrame.contentWindow.trace[0]?.ran&&asyncFrame.contentWindow.trace[0]?.later?'PASS':'FAIL'}`);asyncFrame.remove();
+
+ const cssToken=crypto.randomUUID();
+ const sheet=await server.createEcho('GET','/next-native-blocking.css',{status:200,headers:{'Content-Type':'text/css'},body:'body { color: rgb(0,0,0) }',wait_for_unblock:cssToken});
+ const cssURL=await server.createEcho('GET','/next-native-css-page',{status:200,headers:{'Content-Type':'text/html; charset=utf-8'},body:`<!doctype html PUBLIC "next"><head><script>window.trace=[];<\/script><link rel="stylesheet" href="${sheet}"><script>trace.push({ran:true,later:!!document.getElementById('later')})<\/script></head><body><div/><span id="later">later</span><!--${'a'.repeat(2000)}-->`});
+ const cssFrame=document.createElement('iframe');const cssLoad=new Promise(resolve=>cssFrame.onload=resolve);cssFrame.src=cssURL;document.body.append(cssFrame);
+ for(let i=0;i<200;i++){if((await fetch(server.recordedRequestHeadersURL(sheet))).ok)break;await new Promise(resolve=>setTimeout(resolve,25));}
+ const cssPaused=cssFrame.contentWindow.trace?.length===0&&!cssFrame.contentDocument.getElementById('later');
+ await fetch(new URL(`/unblock/${cssToken}`,sheet));await cssLoad;
+ println(`native stylesheet blocks classic script: ${cssPaused&&cssFrame.contentWindow.trace[0]?.ran&&!cssFrame.contentWindow.trace[0]?.later&&!!cssFrame.contentDocument.getElementById('later')?'PASS':'FAIL'}`);cssFrame.remove();
+
+ const cspURL=await server.createEcho('GET','/next-native-csp',{status:200,headers:{'Content-Type':'text/html; charset=utf-8','Content-Security-Policy':"script-src 'nonce-next-test'"},body:`<!doctype html PUBLIC "next"><body><script nonce="next-test">window.trace=[];<\/script><div id="empty"/><script>trace.push('BAD')<\/script><span id="later">later</span><script nonce="next-test">trace.push({empty:document.getElementById('empty').children.length,parent:document.getElementById('later').parentNode.tagName})<\/script>`});
+ const cspFrame=document.createElement('iframe');const cspLoad=new Promise(resolve=>cspFrame.onload=resolve);cspFrame.src=cspURL;document.body.append(cspFrame);await cspLoad;
+ println(`native CSP remains enforced: ${cspFrame.contentWindow.trace?.length===1&&cspFrame.contentWindow.trace[0]?.empty===0&&cspFrame.contentWindow.trace[0]?.parent==='BODY'?'PASS':'FAIL'}`);cspFrame.remove();
+
+ done();
+});
+
+</script>
