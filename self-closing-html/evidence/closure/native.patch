+ const server=httpTestServer();const url=await server.createEcho('GET','/closure-gc-stress',{status:200,headers:{'Content-Type':'text/html; charset=utf-8'},body:'<!doctype html PUBLIC "self-closing"><body>'+body});
+ const frame=document.createElement('iframe');const loaded=new Promise(resolve=>frame.onload=resolve);frame.src=url;document.body.append(frame);await loaded;
