+<!doctype html>
+<script src="../include.js"></script>
+<script>
+asyncTest(async done=>{
+ const server=httpTestServer();
+ const corpus=await (await fetch(server.getStaticURL('Text/input/HTML/next-parsing-corpus.json'))).json();
+ const signature=node=>{
+  if(node.nodeType===10)return ['doctype',node.name,node.publicId,node.systemId];
+  if(node.nodeType===3)return ['text',node.data];
+  if(node.nodeType===8)return ['comment',node.data];
+  return [node.localName??node.nodeName,node.namespaceURI??null,node.attributes?[...node.attributes].map(a=>[a.name,a.value]):[],[...node.childNodes].map(signature),node.content?signature(node.content):null];
+ };
+ const report={seed:corpus.seed,inputs:corpus.cases.length,compared:0,baselineDisagreements:0,activations:0,mismatches:0,examples:[]};
+ for(let index=0;index<corpus.cases.length;index++){
+  const item=corpus.cases[index];
+  const legacy=new DOMParser().parseFromString(item.source,'text/html');
+  if(JSON.stringify(signature(legacy))!==JSON.stringify(item.baseline)){report.baselineDisagreements++;continue;}
+  const url=await server.createEcho('GET',`/next-corpus-${index}`,{status:200,headers:{'Content-Type':'text/html; charset=utf-8'},body:item.source});
+  const frame=document.createElement('iframe');const loaded=new Promise(resolve=>frame.onload=resolve);frame.src=url;document.body.append(frame);await loaded;
+  const actual=signature(frame.contentDocument);report.compared++;report.activations+=item.activations;
+  if(JSON.stringify(actual)!==JSON.stringify(item.projected)){
+   report.mismatches++;if(report.examples.length<5)report.examples.push({index,source:item.source,expected:item.projected,actual});
+  }
+  frame.remove();
+ }
+ println(JSON.stringify(report));
+ println(`native static refinement: ${report.compared>0&&report.activations>0&&report.mismatches===0?'PASS':'FAIL'}`);
+ done();
+});
+</script>
